# Copy this file to ".env" (same directory as docker-compose.yml) and
# fill in real values before deploying. NEVER commit the real ".env" file --
# it should already be in .gitignore.

# --- Database ---
DB_USER=jobapp
DB_PASSWORD=CHANGE_ME_to_a_real_password
DB_NAME=job_recommendation_db
# Set to "true" if your Postgres provider requires SSL (most managed
# providers -- RDS, Supabase, Render, Neon -- do). Not needed for the
# postgres container defined in this docker-compose.yml.
DB_SSL=false

# --- Auth ---
# Generate a real secret, don't leave this as a placeholder:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# --- Environment ---
NODE_ENV=production

# --- CORS ---
# Comma-separated list of origins allowed to call the backend API.
# Leave empty during local testing to allow all origins.
# Example for production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGIN=

# --- Frontend build-time API URL ---
# This gets baked into the React static bundle at BUILD time, not
# read at runtime. Must point at your real, publicly reachable backend
# URL before you build/deploy the frontend image.
# Example: https://api.yourdomain.com/api
REACT_APP_API_URL=http://localhost:5050/api
